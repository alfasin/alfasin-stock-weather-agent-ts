# Required: Groq API key for LLM inference.
# Get yours at https://console.groq.com/
GROQ_API_KEY=

# Optional: Financial Modeling Prep API key for live stock data.
# Falls back to mock data if missing.
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Optional: override the default Groq model.
# Available models:
# - meta-llama/llama-4-scout-17b-16e-instruct (default, best balance)
# - llama-3.1-8b-instant (highest rate limits, good for workshops)
# - llama-3.3-70b-versatile (smartest, but lowest rate limits)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
